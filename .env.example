# =========================
# Drama MCP Host
# =========================

DRAMA_PLUGIN_ROOT=../drama-plugin/plugin
DRAMA_PLUGIN_CONFIG=../drama-plugin/plugin/config/drama-service-http.example.yaml
DRAMA_MCP_HOST=127.0.0.1
DRAMA_MCP_PORT=8765


# =========================
# Drama Plugin Provider Mode
# =========================

DRAMA_PLUGIN_PROVIDER_MEMORY_MODE=http
DRAMA_PLUGIN_PROVIDER_ASSET_MODE=http
DRAMA_PLUGIN_PROVIDER_MEDIA_MODE=http

DRAMA_PLUGIN_PROVIDER_RESEARCH_MODE=mock
DRAMA_PLUGIN_PROVIDER_PRODUCTION_MODE=mock
DRAMA_PLUGIN_PROVIDER_CONTEXT_MODE=local


# =========================
# Drama Service - Memory
# =========================

DRAMA_PLUGIN_SERVICE_MEMORY_BASE_URL=http://127.0.0.1:8080
DRAMA_PLUGIN_SERVICE_MEMORY_API_TOKEN=<same-as-java-drama-tool-secret>


# =========================
# Drama Service - Asset
# =========================

DRAMA_PLUGIN_SERVICE_ASSET_BASE_URL=http://127.0.0.1:8080
DRAMA_PLUGIN_SERVICE_ASSET_API_TOKEN=<same-as-java-drama-tool-secret>


# =========================
# Drama Service - Media
# =========================

DRAMA_PLUGIN_SERVICE_MEDIA_BASE_URL=http://127.0.0.1:8080
DRAMA_PLUGIN_SERVICE_MEDIA_API_TOKEN=<same-as-java-drama-tool-secret>


# =========================
# Media Import
# =========================

DRAMA_PLUGIN_MEDIA_IMPORT_ALLOWED_ROOTS=D:\home\AI
